<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OPTION B (simpler fallback): poll on a timer. -->
	<!-- launchd runs the script every StartInterval seconds. The script checks
	     whether the device is connected and whether the 5-day window has
	     elapsed, so most runs exit in a fraction of a second. -->

	<key>Label</key>
	<string>com.personal.appresign.poll</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<!-- EDIT: absolute path to resign_and_install.sh on your Mac -->
		<string>/Users/REPLACE_ME/path/to/mac/resign_and_install.sh</string>
	</array>

	<!-- Run every 30 seconds. Bump to 900 (15 min) if you prefer less churn;
	     the device only needs to be plugged in briefly once every ~5 days. -->
	<key>StartInterval</key>
	<integer>30</integer>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/tmp/appresign.out.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/appresign.err.log</string>
</dict>
</plist>
